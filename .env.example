# Copy to .env.local for local builds, or set these in Cloudflare Pages / Vercel
# (Settings > Environment variables). They are read at BUILD time and baked into the static HTML,
# so redeploy after changing one. None of them is secret.
# Leave any unset and the page shows its [[PLACEHOLDER]] instead.

# Public contact email (footer, schema, thank-you and legal pages)
NEXT_PUBLIC_EMAIL=hello@example.com

# Demo line: Twilio number on the Retell demo agent ("Oak Street Property Management").
# Display format, then E.164 for tel: links. 555-01xx numbers are reserved for fiction: safe for testing.
NEXT_PUBLIC_DEMO_PHONE_DISPLAY=(555) 010-0142
NEXT_PUBLIC_DEMO_PHONE_E164=+15550100142

# Setup-call calendar (primary CTA, opens in a modal)
NEXT_PUBLIC_BOOKING_URL=https://example.com/book-setup-call
# Starter checkout (pricing page only). Redirect after payment to /thank-you/
NEXT_PUBLIC_ORDER_FORM_URL=https://example.com/order-starter

# Setup time shown in FAQs and on the thank-you page
NEXT_PUBLIC_GO_LIVE=3 to 5 business days

# Optional: Google Tag Manager container. Empty = GTM off.
NEXT_PUBLIC_GTM_ID=

# Optional: overrides the canonical, OG and sitemap domain. Set it to the preview URL on test
# deploys only. Leave unset in production.
NEXT_PUBLIC_SITE_URL=

# Build gate: 1 lets a build finish while [[PLACEHOLDERS]] remain. Preview builds only.
ALLOW_PLACEHOLDERS=1
